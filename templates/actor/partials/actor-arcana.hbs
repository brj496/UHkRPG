{{!-- TODO: Arcana Partial --}}

<ol class="items-list">
    <div class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Arcana'}}</div>
         Difficulty | Range | Duration | Prepared
    </div>

    {{#each techniques as |item|}}
        {{#ifEquals this.system.techniqueType "arcana"}}
            <div class="accordion-item item" data-item-id="{{item._id}}">
                <div class="accordion-header accordion-toggle flexrow">
                    <div>{{item.name}}</div>

                    {{!-- TODO: Align properly--}}
                    <div>
                        {{item.system.baseDifficulty}} | {{item.system.range}} | {{item.system.duration.length}} {{item.system.duration.durationType}} |
                        <label>
                            <input
                                    type="checkbox"
                                    name="system.prepared"
                                {{checked system.prepared}}
                            />
                        </label>
                    </div>

                    <div class='item-controls'>
                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                            <i class='fas fa-edit'></i>
                        </a>
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    </div>
                </div>
                <hr/>
                <div class="accordion-content" style="display: none;">
                    Arcana Type: {{item.system.arcanaType}}
                    <br/>
                    Damage: {{item.system.damage}}
                    <br/>
                    Damage Type: {{item.system.damageType}}
                    <br/>
                    Description:
                    {{{item.system.description}}}
                    <hr/>
                </div>
            </div>
        {{/ifEquals}}
    {{/each}}
</ol>