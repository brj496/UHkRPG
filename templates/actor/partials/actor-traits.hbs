{{!-- TODO: Traits Part --}}

{{!-- TODO: make an accordion header toggle so that the header doesn't also toggle all of its children. --}}
<ol class='items-list'>
    <div class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Trait Name'}}</div>
        Cute | Spook | Hunger
    </div>
    {{#each traits as |item|}}
        <div class="accordion-item item" data-item-id="{{item._id}}">
            <div class="accordion-header accordion-toggle flexrow">
                <div>{{item.name}}</div>

                <div class='item-controls'>
                    {{item.system.cuteMod}}
                    {{item.system.spookMod}}
                    {{item.system.hungerMod}}
                    {{!-- TODO: add item sheet for traits --}}
                    <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                        <i class='fas fa-edit'></i>
                    </a>
                    <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                        <i class='fas fa-trash'></i>
                    </a>
                </div>
            </div>
            <hr/>
            <div class="accordion-content" style="display: none;">
                {{{item.system.description}}}
                <hr/>
            </div>
        </div>
    {{/each}}
</ol>