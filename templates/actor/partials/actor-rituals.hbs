{{!-- TODO: Ritual Partial --}}

<ol class="items-list">
    <div class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Ritual'}}</div>
        Cost | Casting Time | Duration
    </div>

    {{#each techniques as |item|}}
        {{#ifEquals this.system.techniqueType "ritual"}}
            <div class="accordion-item item" data-item-id="{{item._id}}">
                <div class="accordion-header accordion-toggle flexrow">
                    <div>{{item.name}}</div>

                    {{item.system.ritualCost.count}} {{item.system.ritualCost.costType}} | {{item.system.castingTime.count}} {{item.system.castingTime.actionType}} | {{item.system.duration.length}} {{item.system.duration.durationType}}

                    <div class='item-controls'>
                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                            <i class='fas fa-edit'></i>
                        </a>
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    </div>
                </div>
                <hr/>
                <div class="accordion-content" style="display: none;">
                    Requirements: {{item.system.requirements.arcanaType}} {{item.system.requirements.rank}}
                    <br/>
                    Description:
                    {{{item.system.description}}}
                    <hr/>
                </div>
            </div>
        {{/ifEquals}}
    {{/each}}
</ol>