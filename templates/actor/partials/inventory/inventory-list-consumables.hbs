<ol class="items-list">
    <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Consumables'}}</div>

        {{localize "Count | Bulk | Cost"}}

        <div class='item-controls'>
            <a
                    class='item-control item-create'
                    title='Create item'
                    data-type='consumable'
            >
                <i class='fas fa-plus'></i>
                {{localize 'DOCUMENT.New' type='consumable'}}
            </a>
        </div>
    </li>
    <li id="accordion-container">
        {{#each consumables as |item|}}
            <div class="accordion-item item" data-item-id="{{item._id}}">
                <div class="accordion-header accordion-toggle flexrow">
                    <div>{{item.name}}</div>

                    <div class='item-controls'>

                        {{item.system.count}} | {{item.system.bulk}} | {{item.system.cost}}

                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                            <i class='fas fa-edit'></i>
                        </a>
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    </div>
                </div>
                <hr />
                <div class="accordion-content" style="display: none;">
                    {{!-- TODO: Right now consumables are not created properly and have no datamodel. Need to come up with a better way of creating consumables. --}}

                    {{!-- Generic --}}
                    {{#if item.system.bulk}}
                        Bulk: {{item.system.bulk}}
                    {{/if}}

                    {{#if item.system.count}}
                        Count: {{item.system.count}}
                    {{/if}}

                    {{#if item.system.effect}}
                        Effect: {{{item.system.effect}}}
                    {{/if}}
                    {{#if item.system.cost}}
                        Cost: {{item.system.cost}}
                    {{/if}}
                    {{#if item.system.rarity}}
                        Rarity: {{item.system.rarity}}
                    {{/if}}

                    {{!-- Food Specific --}}
                    {{#if item.system.spoilage}}
                        Spoilage: {{item.system.spoilage}}
                    {{/if}}

                    {{#if item.system.belly}}
                        Belly: {{item.system.belly}}
                    {{/if}}

                    {{#if item.system.costPerServing}}
                        Cost Per Serving: {{item.system.costPerServing}}
                    {{/if}}

                    {{!-- Potion Specific --}}
                    {{#if item.system.isAlcohol}}
                        isAlcohol: {{item.system.isAlcohol}}
                    {{/if}}
                    {{#if item.system.strain}}
                        Strain: {{item.system.strain}}
                    {{/if}}

                    {{#if item.system.effects}}
                        {{#if item.system.effects.overdose}}
                            Overdose Effect: {{item.system.effects.overdose}}
                            Effect: {{{item.system.effects.effect}}}
                        {{/if}}
                    {{/if}}

                    {{!-- Poison Specific --}}
                    {{#if item.system.doses}}
                        Doses: {{item.system.doses}}
                    {{/if}}

                    {{!-- Flask Specific --}}
                    {{#if item.system.isRejuvenating}}
                        Rejuvenating: {{item.system.isRejuvenating}}
                    {{/if}}
                    {{#if item.system.effects}}
                        {{#if item.system.effects.targeted}}
                            Targeted: {{item.system.effects.targeted}}
                            {{#if item.system.effects.isPlus}}
                                Terrain+: {{item.system.effects.targeted}}
                            {{else}}
                                Terrain: {{item.system.effects.targeted}}
                            {{/if}}
                            Ingested: {{item.system.effects.targeted}}
                        {{/if}}
                    {{/if}}

                    {{!-- Trap Specific --}}
                    {{#if item.system.isReusable}}
                        Reusable: {{item.system.isReusable}}
                    {{/if}}
                </div>
            </div>
        {{/each}}
    </li>
</ol>

