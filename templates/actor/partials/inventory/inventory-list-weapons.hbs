<li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Weapons'}}</div>
    {{localize "Type | Damage | Range | Hands | Quality | Bulk | Cost"}}
</li>
<li id="accordion-container">
    {{#each weapons as |item|}}
        <div class="accordion-item item" data-item-id="{{item._id}}">
            <div class="accordion-header accordion-toggle flexrow">
                <div>{{item.name}}</div>

                {{item.system.type}} | {{item.system.damage.value}} | {{item.system.range}} | {{item.system.hands}} | {{item.system.quality}} | {{item.system.bulk}} | {{item.system.cost}}

                <div class='item-controls'>

                    {{!-- Display: Name | Type | Damage | Range | Hands | Quality | Bulk | Cost --}}

                    <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                        <i class='fas fa-edit'></i>
                    </a>
                    <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                        <i class='fas fa-trash'></i>
                    </a>
                </div>
            </div>
            <hr />
            <div class="accordion-content" style="display: none;">
                Type: {{item.system.type}}
                <br/>
                Hands: {{item.system.hands}}
                <br/>
                Effect: {{{item.system.effect}}}
                <br/>

                {{#if item.system.isArcaneFocus}}
                    <div>
                        Attuned: {{item.system.attuned}}
                    </div>
                {{/if}}

                {{> "systems/u-hk-rpg/templates/actor/partials/inventory/inventory-item-modifiers.hbs"}}
            </div>
        </div>
    {{/each}}
</li>