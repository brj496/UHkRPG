<div class="stat-card">
    <div class="stat-card-header">
        {{label}}
    </div>

    <div class="stat-card-content">
        <input
            type="number"
            class="stat-card-value"
            name="{{name}}"
            value="{{value}}"
            data-dtype="Number"
        />
        <span>/</span>
        <span
                class="stat-card-value"
        >
            {{max}}
        </span>
    </div>
</div>