<li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Tools'}}</div>
    {{localize "Type | Bulk | Cost"}}
</li>
<li id="accordion-container">
    {{#each tools as |item|}}
        <div class="accordion-item item" data-item-id="{{item._id}}">
            <div class="accordion-header accordion-toggle flexrow">
                <div>{{item.name}}</div>

                <div class='item-controls'>

                    {{!-- Display: Bulk | Quality | Cost --}}

                    <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                        <i class='fas fa-edit'></i>
                    </a>
                    <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                        <i class='fas fa-trash'></i>
                    </a>
                </div>
            </div>
            <hr />
            <div class="accordion-content" style="display: none;">
                <p>{{item.system.weaponType}}</p>
                <p>Skills:</p>
                <ul>
                    {{#each system.skills as |skill key|}}
                        <li>
                            <div class="flexrow">
                                <label
                                        for="system.skills.{{key}}.value"
                                        class="skill-label flexlarge flex-group-left"
                                        data-label="{{skill.name}}"
                                >
                                    {{skill.name}}
                                </label>
                            </div>
                        </li>
                    {{/each}}
                </ul>
                <hr/>
            </div>
        </div>
    {{/each}}
</li>