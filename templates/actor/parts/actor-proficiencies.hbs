<ol class='items-list'>
    <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-controls'>
            <a
                    class='item-control item-create'
                    title='Create item'
                    data-type='proficiency'
            >
                <i class='fas fa-plus'></i>
                {{localize 'DOCUMENT.New' type='proficiency'}}
            </a>
        </div>
    </li>
    <li id="accordion-container">
        {{#each proficiencies as |item|}}
            <div class="accordion-item item" data-item-id="{{item._id}}">
                <div class="accordion-header accordion-toggle flexrow">
                    <div>{{item.name}}</div>

                    <div class='item-controls'>
                        Rank: {{item.system.rank}}
                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                            <i class='fas fa-edit'></i>
                        </a>
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    </div>
                </div>
                <hr/>
                <div class="accordion-content" style="display: none;">
                    {{{item.system.description}}}
                    <p>Skills:</p>
                    <ul>
                        {{#each system.skills as |skill key|}}
                            <li>
                                <div class="flexrow">
                                    <label
                                            for="system.skills.{{key}}.value"
                                            class="skill-label flexlarge flex-group-left"
                                            data-label="{{skill.name}}"
                                    >
                                        {{skill.name}}
                                    </label>
                                    <label class="flex-group-right">
                                        rerolls: {{skill.rerolls}}
                                    </label>
                                    <div class="mastery-circle {{#if skill.mastery}}mastery-filled-circle{{/if}}"></div>
                                </div>

                            </li>
                        {{/each}}
                    </ul>
                    <hr/>
                </div>
            </div>
        {{/each}}
    </li>
</ol>