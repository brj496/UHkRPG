{{!-- TODO: Actor's inventory --}}
<div>
    Geo: {{system.geo.value}}
</div>
<div>
    Carried Bulk: {{system.bulk.value}} {{!-- TODO: This bulk here should be the combined bulk of the carried/equipped items --}}
</div>
<div>
    Load: {{system.secondaryAttributes.load.value}}
</div>
<div>
    Belt Size: {{system.secondaryAttributes.beltSize.value}}
</div>
<ol class="items-list">
    {{!-- Weapons --}}
    <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Weapons'}}</div>
        {{localize "Type | Damage | Range | Hands | Quality | Bulk | Cost"}}
    </li>
    <li id="accordion-container">
        {{#each weapons as |item|}}
            <div class="accordion-item item" data-item-id="{{item._id}}">
                <div class="accordion-header accordion-toggle flexrow">
                    <div>{{item.name}}</div>

                    <div class='item-controls'>

                        {{!-- Display: Name | Type | Damage | Range | Hands | Quality | Bulk | Cost --}}

                        <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                            <i class='fas fa-edit'></i>
                        </a>
                        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                            <i class='fas fa-trash'></i>
                        </a>
                    </div>
                </div>
                <hr />
                <div class="accordion-content" style="display: none;">
                    {{{item.system.effect}}}
                    <br/>
                    <div class='item flexrow items-header'>
                        <div class='item-name'>{{localize 'Modifiers'}}</div>
                        {{localize "Name | Effect | Cost"}}
                    </div>
                    {{!-- TODO: This may need to change based on how modifiers are handled. --}}
                    {{#each system.modifiers as |modifier|}}
                        <div class="flexrow">
                            <div>{{item.name}}</div>

                            <div class='item-controls'>

                                {{!-- Display: Name | Type | Damage | Range | Hands | Quality | Bulk | Cost --}}

                                <a class='item-control item-edit' title='{{localize "DOCUMENT.Edit"}}'>
                                    <i class='fas fa-edit'></i>
                                </a>
                                <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete"}}'>
                                    <i class='fas fa-trash'></i>
                                </a>
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/each}}
    </li>

