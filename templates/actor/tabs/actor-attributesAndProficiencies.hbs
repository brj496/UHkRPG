
<div class="tab attributesAndProficiencies" data-group="primary" data-tab="attributesAndProficiencies">
    <section class="grid grid-3col">
        <aside class="sidebar">

            {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
            use both the "grid" and "grid-Ncol" class where "N" can be any number
            from 1 to 12 and will create that number of columns.  --}}
            <div class="attributes flexcol">
                {{#each system.attributes as |attribute key|}}
                    <div class="attribute flexrow flex-group-center">
                        <label for="system.attributes.{{key}}.value"
                               class="resource-label rollable flexlarge align-left"
                               data-roll="d6"
                               data-label="{{localize (lookup @root.config.attributes key)}}">{{localize
                                (lookup @root.config.attributes key)}}</label>
                        <input type="text" name="system.attributes.{{key}}.value" value="{{attribute.value}}"
                               data-dtype="Number"/>
                    </div>
                {{/each}}
            </div>
        </aside>

        {{!-- For the main features list, span the right two columns --}}
        {{!-- TODO: Proficiency Section --}}
        <section class="main grid-span-2">
            {{!-- This is a Handlebars partial. They're stored in the `/parts` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
            {{> "systems/u-hk-rpg/templates/actor/parts/actor-proficiencies.hbs"}}
        </section>

    </section>
</div>