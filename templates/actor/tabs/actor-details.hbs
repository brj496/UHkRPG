<div class="tab details" data-group="primary" data-tab="details">
    Attributes
    <hr>
    <section class="grid grid-4col">
        {{#each system.attributes}}
            {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"}}
        {{/each}}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
