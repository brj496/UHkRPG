                label="Spook"
                value=system.spook
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Speed"
                value=system.speed
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Load"
                value=system.load
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Hunger"
                value=system.hunger.value
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Cute"
                value=system.cute
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Absorption"
                value=system.absorption
        }}

    </section>

