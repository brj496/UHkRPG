{{!-- TODO: Details Tab --}}


<div class="tab details" data-group="primary" data-tab="details">
    Attributes:
    <hr>
    <section class="grid grid-4col">
        {{#each system.attributes}}
            {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"}}
        {{/each}}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Bulk"
                value=system.bulk
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/editable-stat-card-max.hbs"
            label="Belly"
            name="system.belly.value"
            value=system.belly.value
            max=system.belly.max
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Spook"
                value=system.spook
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Speed"
                value=system.speed
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/editable-stat-card.hbs"
                label="Load"
                name="system.load"
                value=system.load
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Hunger"
                value=system.hunger.value
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Cute"
                value=system.cute
        }}
        {{> "systems/u-hk-rpg/templates/actor/partials/stats/stat-card.hbs"
                label="Absorption"
                value=system.absorption
        }}

    </section>

    {{!--TODO: Add functionality to Rest/ Check Roll Buttons" --}}

    <section>
        <button>
            Rest
        </button>
        <button>
            Roll
        </button>
    </section>

    {{!-- For the main features list, span the right two columns --}}
    Proficiencies:
    <hr>
    <section class="main grid-span-2">
        {{!-- This is a Handlebars partial. They're stored in the `/partials` folder next to this sheet, and defined in module/helpers/templates.mjs --}}
        {{> "systems/u-hk-rpg/templates/actor/partials/actor-proficiencies.hbs"}}
    </section>

    Traits:
    <hr>
    <section>
        {{> "systems/u-hk-rpg/templates/actor/partials/actor-traits.hbs"}}
    </section>
</div>