<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

    {{!-- Sheet Header --}}
    {{> "systems/u-hk-rpg/templates/actor/parts/actor-header.hbs"}}

    {{!-- Sheet Tab Navigation --}}
    <nav class="sheet-tabs tabs" data-group="primary">
        {{!-- Default tab is specified in actor-sheet.mjs --}}
        <a class="item" data-tab="attributesAndProficiencies">Attributes/Proficiencies</a>
        <a class="item" data-tab="traitsAndPaths">Traits/Paths</a>
        <a class="item" data-tab="inventory">Inventory</a>
        <a class="item" data-tab="techniques">Techniques</a>
        <a class="item" data-tab="biography">Biography</a>
        <a class="item" data-tab="notes">Notes</a>
    </nav>

    {{!-- Sheet Body --}}
    <section class="sheet-body">

        {{!-- Character Attributes and Proficiencies Tab --}}
        <div class="tab attributesAndProficiencies" data-group="primary" data-tab="attributesAndProficiencies">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-attributesAndProficiencies.hbs"}}
        </div>

        {{!-- Traits and Paths Tab --}}
        <div class="tab traitsAndPaths" data-group="primary" data-tab="traitsAndPaths">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-traitsAndPaths.hbs"}}
        </div>

        {{!-- Inventory Tab --}}
        <div class="tab inventory" data-group="primary" data-tab="inventory">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-inventory.hbs"}}
        </div>

        {{!-- Techniques Tab --}}
        <div class="tab techniques" data-group="primary" data-tab="techniques">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-techniques.hbs"}}
        </div>

        {{!-- Biography Tab --}}
        <div class="tab biography" data-group="primary" data-tab="biography">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-biography.hbs"}}
        </div>

        {{!-- Notes Tab --}}
        <div class="tab notes" data-group="primary" data-tab="notes">
            {{> "systems/u-hk-rpg/templates/actor/tabs/actor-notes.hbs"}}
        </div>
        </section>
</form>
