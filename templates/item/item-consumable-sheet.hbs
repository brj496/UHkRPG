<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        <label>
            Type:
            <select name="system.type">
                <option value="" disabled {{#unless item.system.type}}selected{{/unless}}>
                    Select Type
                </option>
                {{selectOptions
                        config.consumableTypes
                        selected=system.type
                        labelAttr="label"
                        localize=true
                }}
            </select>
        </label>
    </section>
</form>