<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        {{formField fields.type.value value=source.type.value choices=CONFIG.consumableTypes lableAttr="label" label="U_HK_RPG.CONSUMABLE.Type" localize=true}}


        <label for="consumableType">Consumable Type</label>




<!--        <select name="consumableType" id="consumableType">-->
<!--            <option value=""></option>-->
<!--        </select>-->

    </section>

</form>