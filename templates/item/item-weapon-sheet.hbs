{{!-- TODO: Handle Damage properly, currently does not have a damage type set--}}
{{!-- TODO: Handle Hands properly, its just a string currently, should be a selection box--}}

<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        <div class="weapon-types">
            <label>{{localize "U_HK_RPG.Item.Weapon.Type.Label"}}</label>

            {{!-- Selected tags --}}
            <div class="tags">
                {{#each system.type as |type index|}}
                    <span class="tag" data-index="{{index}}">
                        {{localize (lookup (lookup @root.config.weaponTypes type) 'label')}}
                        <a class="remove-tag" data-index="{{index}}">✖</a>
                    </span>
                {{/each}}
            </div>

            <div class="tag-controls">
                <select name="new-type">
                    {{#each config.weaponTypes as |type key|}}
                        {{#unless (includes system.type key)}}
                            <option value="{{key}}">
                                {{localize type.label}}
                            </option>
                        {{/unless}}
                    {{/each}}
                </select>

                <button type="button" class="add-tag">
                    Add Type
                </button>
            </div>
        </div>

        <div class="base-fields flexrow grid-2col">
            <p>Damage Value: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.damage.value"
                        type="number"
                        value="{{system.damage.value}}"
                        data-dtype="Number"
                />
            </label>
            <p>Range Type: </p>
            <label>
                <select name="system.range">
                    <option value="" disabled {{#unless item.system.range}}selected{{/unless}}>
                        Select Range
                    </option>
                    {{selectOptions
                            config.weaponRanges
                            selected=system.range.type
                            labelAttr="label"
                            localize=true
                    }}
                </select>
            </label>
            {{#ifEquals system.range "ranged"}}
                <p>Range: </p>
                <label class="flexrow flex-group-left">
                    <input
                            name="system.range.value"
                            type="number"
                            value="{{system.range.value}}"
                            data-dtype="Number"
                    />
                </label>
            {{/ifEquals}}
            <p>Hands: </p>
            <label>
                <select name="system.hands">
                    <option value="" disabled {{#unless item.system.hands}}selected{{/unless}}>
                        Select Hands
                    </option>
                    {{selectOptions
                            config.handTypes
                            selected=system.hands
                            labelAttr="label"
                            localize=true
                    }}
                </select>
            </label>
            <p>Quality: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.quality"
                        type="number"
                        value="{{system.quality}}"
                        data-dtype="Number"
                />
            </label>
            <p>Bulk: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.bulk"
                        type="number"
                        value="{{system.bulk}}"
                        data-dtype="Number"
                />
            </label>
            <p>Cost: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.cost"
                        type="number"
                        value="{{system.cost}}"
                        data-dtype="Number"
                />
            </label>
            <div class="flexrow grid-2col">
                <p>Equipped?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.equipped"
                        {{checked system.equipped}}
                    />
                </label>
                <p>Natural Weapon?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.naturalWeapon"
                        {{checked system.naturalWeapon}}
                    />
                </label>
                <p>Arcane Focus?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.isArcaneFocus"
                        {{checked system.isArcaneFocus}}
                    />
                </label>
            </div>
            {{#if system.isArcaneFocus}}
                <p>Attuned?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.isAttuned"
                        {{checked system.isAttuned}}
                    />
                </label>
            {{/if}}
        </div>
        <h3>Description: </h3>
        <div class="tab">
            {{editor
                    enrichedDescription
                    target="system.description"
                    engine="prosemirror"
                    button=true
                    editable=editable
            }}
        </div>
        {{#if system.isArcaneFocus}}
            <h3>Techniques</h3>
            <div class="form-group modifier-section">
                <label class="resource-label">Techniques:</label>

                {{#each techniques as |technique|}}
                    <div class="modifier-card" data-item-id="{{technique.id}}">
                        {{!-- Card Header: Icon, Name, Cost, and Remove Button --}}
                        <div class="card-header">
                            <img class="modifier-img" src="{{technique.img}}" width="36" height="36" title="{{technique.name}}"/>

                            <div class="header-details">
                                <h4 class="modifier-title">{{technique.name}}</h4>
                                {{#if technique.system.cost}}
                                    <span class="modifier-cost"><strong>Cost:</strong> {{technique.system.cost}}</span>
                                {{/if}}
                            </div>

                            <a class="remove-technique" title="Remove Technique" data-technique-id="{{technique.id}}">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>

                        {{!-- Card Body: Description --}}
                        {{#if technique.system.description}}
                            <div class="card-body modifier-description">
                                {{{technique.enrichedDescription}}}
                            </div>
                        {{/if}}
                    </div>
                {{else}}
                    <div class="modifier-card empty-slot">
                        <i class="fas fa-plus-circle"></i>
                        <span>Drag and drop Technique items here</span>
                    </div>
                {{/each}}
            </div>
        {{else}}
            <h3>Modifier</h3>
            <div class="form-group modifier-section">
                <label class="resource-label">Modifier:</label>

                {{#if modifier}}
                    <div class="modifier-card" data-item-id="{{modifier.id}}">
                        {{!-- Card Header: Icon, Name, Cost, and Remove Button --}}
                        <div class="card-header">
                            <img class="modifier-img" src="{{modifier.img}}" width="36" height="36" title="{{modifier.name}}"/>

                            <div class="header-details">
                                <h4 class="modifier-title">{{modifier.name}}</h4>
                                {{#if modifier.system.cost}}
                                    <span class="modifier-cost"><strong>Cost:</strong> {{modifier.system.cost}}</span>
                                {{/if}}
                            </div>

                            <a class="remove-modifier" title="Remove Modifier">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>

                        {{!-- Card Body: Description --}}
                        {{#if modifier.system.description}}
                            <div class="card-body modifier-description">
                                {{{modifier.enrichedDescription}}}
                            </div>
                        {{/if}}
                    </div>
                {{else}}
                    <div class="modifier-card empty-slot">
                        <i class="fas fa-plus-circle"></i>
                        <span>Drag and drop a Modifier item here</span>
                    </div>
                {{/if}}
            </div>
        {{/if}}

    </section>
</form>