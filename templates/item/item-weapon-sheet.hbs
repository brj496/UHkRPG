<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        {{!-- Things to edit:
        Weapon Name
        Type
        Damage
        Range
        Hands
        Quality
        Bulk
        Cost
        isArcane Focus
        isAttuned
        Effect
        --}}


    </section>
</form>