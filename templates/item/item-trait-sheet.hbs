<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>
    <section class="sheet-body">
        <label>
            Type:
            <select name="system.type">
                <option value="" disabled {{#unless item.system.type}}selected{{/unless}}>
                    Select Type
                </option>
                {{selectOptions
                        config.traitTypes
                        selected=system.type
                        labelAttr="label"
                        localize=true
                }}
            </select>
        </label>

        <div class="base-fields flexrow grid-2col">
            <p>Cute Modifier: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.cuteMod"
                        type="number"
                        value="{{system.cuteMod}}"
                        data-dtype="Number"
                />
            </label>
            <p>Spook Modifier: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.spookMod"
                        type="number"
                        value="{{system.spookMod}}"
                        data-dtype="Number"
                />
            </label>
            <p>Hunger Modifier: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.hungerMod"
                        type="number"
                        value="{{system.hungerMod}}"
                        data-dtype="Number"
                />
            </label>
        </div>
        <!-- TODO: Parent Trait Attachment-->
        <!-- TODO: Natural Weapon Attachment-->
        <h3>Description: </h3>
        <div class="tab">
            {{editor
                    enrichedDescription
                    target="system.description"
                    engine="prosemirror"
                    button=true
                    editable=editable
            }}
        </div>
    </section>

</form>
