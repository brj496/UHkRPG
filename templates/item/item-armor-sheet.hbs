<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        <div class="flexrow grid-3col">
            <div class="grid-span-2">Durability: </div>
            <div class="flex-group-left">
                Max Durability:
                <input
                        name="system.durability.max"
                        type="number"
                        value="{{system.durability.max}}"
                        data-dtype="Number"
                />
                Current Durability:
                <input
                        name="system.durability.current"
                        type="number"
                        value="{{system.durability.current}}"
                        data-dtype="Number"
                />
            </div>
        </div>
        <div class="base-fields flexrow grid-2col">
            <p>Damage Reduction: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.damageReduction"
                        type="number"
                        value="{{system.damageReduction}}"
                        data-dtype="Number"
                />
            </label>
            <p>Bulk: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.bulk"
                        type="number"
                        value="{{system.bulk}}"
                        data-dtype="Number"
                />
            </label>
            <p>Cost: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.cost"
                        type="number"
                        value="{{system.cost}}"
                        data-dtype="Number"
                />
            </label>
            <div class="flexrow grid-2col">
                <p>Equipped?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.equipped"
                        {{checked system.equipped}}
                    />
                </label>
            </div>
        </div>
        <h3>Description: </h3>
        <hr/>
        <div class="tab">
            {{editor
                    enrichedDescription
                    target="system.description"
                    engine="prosemirror"
                    button=true
                    editable=editable
            }}
        </div>

        <div class="form-group modifier-section">
            <label class="resource-label">Modifier:</label>

            {{#if modifier}}
                <h3>Modifier</h3>
                <div class="form-group modifier-section">
                    <label class="resource-label">Modifier:</label>

                    {{#if modifier}}
                        <div class="modifier-card" data-item-id="{{modifier.id}}">
                            {{!-- Card Header: Icon, Name, Cost, and Remove Button --}}
                            <div class="card-header">
                                <img class="modifier-img" src="{{modifier.img}}" width="36" height="36" title="{{modifier.name}}"/>

                                <div class="header-details">
                                    <h4 class="modifier-title">{{modifier.name}}</h4>
                                    {{#if modifier.system.cost}}
                                        <span class="modifier-cost"><strong>Cost:</strong> {{modifier.system.cost}}</span>
                                    {{/if}}
                                </div>

                                <a class="remove-modifier" title="Remove Modifier">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>

                            {{!-- Card Body: Description --}}
                            {{#if modifier.system.description}}
                                <div class="card-body modifier-description">
                                    {{{modifier.enrichedDescription}}}
                                </div>
                            {{/if}}
                        </div>
                    {{else}}
                        <div class="modifier-card empty-slot">
                            <i class="fas fa-plus-circle"></i>
                            <span>Drag and drop a Modifier item here</span>
                        </div>
                    {{/if}}
                </div>
            {{else}}
                <div class="modifier-card empty-slot">
                    <i class="fas fa-plus-circle"></i>
                    <span>Drag and drop a Modifier item here</span>
                </div>
            {{/if}}
        </div>
    </section>
    {{!TODO: Display Modifiers here.}}
</form>