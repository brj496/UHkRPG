<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>
    <section class="sheet-body">
        <div class="base-fields flexrow grid-2col">
            <p>Bulk: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.bulk"
                        type="number"
                        value="{{system.bulk}}"
                        data-dtype="Number"
                />
            </label>
            <p>Cost: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.cost"
                        type="number"
                        value="{{system.cost}}"
                        data-dtype="Number"
                />
            </label>
            <div class="flexrow grid-2col">
                <p>On Belt?: </p>
                <label>
                    <input
                            type="checkbox"
                            name="system.isOnBelt"
                        {{checked system.isOnBelt}}
                    />
                </label>
            </div>
        </div>
        <p>Effect: </p>
        <hr/>
        <div class="tab">
            {{editor
                    enrichedDescription
                    target="system.effect"
                    engine="prosemirror"
                    button=true
                    editable=editable
            }}
        </div>
    </section>
</form>