<form class='{{cssClass}}' autocomplete='off'>
    <header class="sheet-header">
        <img
                class='profile-img'
                src='{{item.img}}'
                data-edit='img'
                title='{{item.name}}'
        />
        <div class="header-fields">
            <h1 class="charname">
                <label>
                    <input
                            name="name"
                            type="text"
                            value="{{item.name}}"
                            placeholder="Name"
                    />
                </label>
            </h1>
        </div>
    </header>

    <section class="sheet-body">
        <label>
            Type:
            <select name="system.itemType">
                <option value="" disabled {{#unless item.system.itemType}}selected{{/unless}}>
                    Select Type
                </option>
                {{selectOptions
                        config.modifierTypes
                        selected=system.itemType
                        labelAttr="label"
                        localize=true
                }}
            </select>
        </label>

        <div class="base-fields flexrow grid-2col">
            <p>Cost Formula: </p>
            <label class="flexrow flex-group-left">
                <input
                        name="system.cost"
                        type="text"
                        value="{{system.cost}}"
                        data-dtype="String"
                />
            </label>
        </div>
        <div class="tab">
            {{editor
                    enrichedDescription
                    target="system.description"
                    engine="prosemirror"
                    button=true
                    editable=editable
            }}
        </div>
    </section>
</form>